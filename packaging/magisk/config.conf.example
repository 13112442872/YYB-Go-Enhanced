# YYB Go Magisk runtime configuration.
# Quote values that contain spaces, &, #, or other shell characters.

HOST=127.0.0.1
PORT=8000
KEEPALIVE_INTERVAL=30m
KEEPALIVE_AHEAD=45m
TCP_PROXY=

# Optional QingLong or daidai-panel integration.
PANEL_TYPE=qinglong
QL_URL=
QL_CLIENT_ID=
QL_CLIENT_SECRET=
DAIDAI_URL=
DAIDAI_APP_KEY=
DAIDAI_APP_SECRET=
YYB_QINGLONG_SERVER=
YYB_QINGLONG_REPO=

# Browser authentication is enabled only when a reachable MySQL DSN is set.
# Keep HOST=127.0.0.1 when this is empty.
YYB_AUTH_MYSQL_DSN=
YYB_ADMIN_USER=admin
YYB_ADMIN_PASSWORD=
YYB_COOKIE_SECURE=false
