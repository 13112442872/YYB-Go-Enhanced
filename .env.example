# ==========================================
# YYB Go 环境变量配置文件示例
# ==========================================

# MySQL 用户认证与首次管理员。已有 YYB_WEB_* 变量也可作为兼容回退。
YYB_AUTH_MYSQL_DSN=yyb_go:replace-db-password@tcp(youchat-mysql:3306)/yyb_go?charset=utf8mb4&parseTime=true&loc=UTC
YYB_ADMIN_USER=admin
YYB_ADMIN_PASSWORD=replace-with-a-strong-password
# 使用 HTTPS 反代时改为 true
YYB_COOKIE_SECURE=false

# 服务绑定地址与端口
YYB_BIND_ADDRESS=0.0.0.0
YYB_PORT=8000

# 账号保活检查间隔与提前刷新时间
YYB_KEEPALIVE_INTERVAL=30m
YYB_KEEPALIVE_AHEAD=45m

# ------------------------------------------
# 面板类型配置 (PANEL_TYPE)
# 可选值: qinglong (默认青龙面板) 或 daidai (呆呆面板)
# 当指定 PANEL_TYPE=daidai 时，系统会自动切换至呆呆面板适配模式并使用对应的默认 URL(http://daidai-panel:5700)
# ------------------------------------------
PANEL_TYPE=qinglong

# 青龙面板配置 (当 PANEL_TYPE=qinglong 时生效)
# QL_URL 默认为 http://qinglong:5700
QL_URL=http://qinglong:5700
QL_CLIENT_ID=
QL_CLIENT_SECRET=

# 呆呆面板配置 (当 PANEL_TYPE=daidai 时可单独指定，不填则自动使用默认 http://daidai-panel:5700)
# DAIDAI_URL=http://daidai-panel:5700
# DAIDAI_APP_KEY=
# DAIDAI_APP_SECRET=

# YYB 回调地址 (供青龙/呆呆面板中的脚本回调使用)
YYB_QINGLONG_SERVER=yyb-go:8000

# 同步的脚本仓库列表 (多个库用逗号分隔)
YYB_QINGLONG_REPO=SuperNaiBA_YYB-GO-Script,525815266_YYB-Go-Enhanced/scripts
